# ============================================================
# 交付配置模板 / Delivery config template
# 复制本文件为 .env 后填写；留空则跳过对应交付步骤。
# Copy this file to .env and fill in; leave blank to skip that step.
# 注意：本仓库不包含任何真实密钥，所有值均需你自行提供。
# NOTE: this repo ships no real secrets — supply your own values.
# ============================================================

# ---------- 对象存储交付（可选） / Object storage delivery (optional) ----------
# 示例：阿里云 OSS / AWS S3 / 任意兼容 S3 的服务
# e.g. Aliyun OSS / AWS S3 / any S3-compatible service
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 交付前缀（在 bucket 下建与电影同名的子目录）
# delivery prefix (a per-film subfolder is created under this prefix)
OSS_DELIVERY_PREFIX=trae-files-temp

# ---------- 交付后通知（可选） / Post-delivery notify (optional) ----------
# 例如：私人剪贴板 / 消息机器人
# e.g. private clipboard / chat bot
NOTIFY_URL=
NOTIFY_API_ID=
NOTIFY_API_KEY=
